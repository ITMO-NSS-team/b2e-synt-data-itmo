 },
 "components": {
  "schemas": {
   "CreateSession": {
    "properties": {
     "employee_id": {
      "type": "string",
      "title": "Employee Id"
     },
     "config_ref": {
      "type": "string",
      "title": "Config Ref",
      "default": "agent_config"
     },
     "metadata": {
      "additionalProperties": true,
      "type": "object",
      "title": "Metadata"
     }
    },
    "type": "object",
    "required": [
     "employee_id"
    ],
    "title": "CreateSession"
   },
   "ExperimentRequest": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name"
     },
     "questions": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Questions"
     },
     "basket_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Basket Id"
     },
     "employee_ids": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Employee Ids"
     },
     "config_matrix": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array",
      "title": "Config Matrix"
     },
     "max_tokens": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Max Tokens"
     },
     "max_usd": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Max Usd"
     },
     "expected_calls_per_question": {
      "type": "integer",
      "title": "Expected Calls Per Question",
      "default": 6
     }
    },
    "type": "object",
    "required": [
     "name",
     "employee_ids"
    ],
    "title": "ExperimentRequest",
    "description": "A batch over a config matrix.\n\n``budget`` is required. An experiment without a declared ceiling is refused\nrather than defaulted, because a default ceiling is one nobody chose."
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "PostMessage": {
    "properties": {
     "content": {
      "type": "string",
      "title": "Content"
     },
     "question_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Question Id"
     }
    },
    "type": "object",
    "required": [
     "content"
    ],
    "title": "PostMessage"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}