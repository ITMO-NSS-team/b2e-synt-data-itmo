{
 "openapi": "3.1.0",
 "info": {
  "title": "B2E research API",
  "description": "Read/write API for researchers. Thin layer over Phoenix and the run store. Traces live in Phoenix; feedback is stored as Phoenix annotations, not in a bespoke table.",
  "version": "0.1.0"
 },
 "paths": {
  "/healthz": {
   "get": {
    "summary": "Healthz",
    "operationId": "healthz_healthz_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "type": "object",
         "title": "Response Healthz Healthz Get"
        }
       }
      }
     }
    }
   }
  },
  "/traces/{session_id}": {
   "get": {
    "summary": "Full span tree for one session",
    "operationId": "get_trace_traces__session_id__get",
    "parameters": [
     {
      "name": "session_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Session Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "additionalProperties": true,
         "title": "Response Get Trace Traces  Session Id  Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/sessions": {
   "get": {
    "summary": "List or search sessions",
    "operationId": "list_sessions_sessions_get",
    "parameters": [
     {
      "name": "employee_id",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Employee Id"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 500,
       "default": 50,
       "title": "Limit"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "additionalProperties": true,
         "title": "Response List Sessions Sessions Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/feedback": {
   "post": {
    "summary": "Write feedback as a Phoenix annotation",
    "operationId": "post_feedback_feedback_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/FeedbackIn"
       }
      }
     },
     "required": true
    },
    "responses": {
     "201": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "type": "object",
         "title": "Response Post Feedback Feedback Post"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/experiments": {
   "post": {
    "summary": "Launch a batch run",
    "operationId": "create_experiment_experiments_post",
    "parameters": [
     {
      "name": "idempotency-key",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Idempotency-Key"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ExperimentIn"
       }
      }
     }
    },
    "responses": {
     "202": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/experiments/{experiment_id}": {
   "get": {
    "summary": "Status and metrics vs the oracle question bank",
    "operationId": "get_experiment_experiments__experiment_id__get",
    "parameters": [
     {
      "name": "experiment_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Experiment Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "additionalProperties": true,
         "title": "Response Get Experiment Experiments  Experiment Id  Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/experiments/{experiment_id}/export": {
   "get": {
    "summary": "Export runs as Parquet or JSONL",
    "operationId": "export_experiment_experiments__experiment_id__export_get",
    "parameters": [
     {
      "name": "experiment_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Experiment Id"
      }
     },
     {
      "name": "fmt",
      "in": "query",
      "required": false,
      "schema": {
       "enum": [
        "jsonl",
        "parquet"
       ],
       "type": "string",
       "default": "jsonl",
       "title": "Fmt"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "ExperimentIn": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name"
     },
     "questions": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Questions"
     },
     "basket_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Basket Id"
     },
     "employee_ids": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Employee Ids"
     },
     "config_matrix": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array",
      "title": "Config Matrix"
     },
     "max_tokens": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Max Tokens"
     },
     "max_usd": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Max Usd"
     },
     "idempotency_key": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Idempotency Key"
     }
    },
    "type": "object",
    "required": [
     "name",
     "employee_ids"
    ],
    "title": "ExperimentIn"
   },
   "FeedbackIn": {
    "properties": {
     "session_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Session Id"
     },
     "span_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Span Id"
     },
     "label": {
      "type": "string",
      "enum": [
       "like",
       "dislike"
      ],
      "title": "Label"
     },
     "explanation": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Explanation"
     },
     "annotator": {
      "type": "string",
      "title": "Annotator",
      "default": "researcher"
     }
    },
    "type": "object",
    "required": [
     "label"
    ],
    "title": "FeedbackIn",
    "description": "Feedback at session OR individual-response level.\n\nExactly one target is required. Accepting both would silently pick one and\nattach the annotation somewhere the researcher did not intend."
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}