# The single externally reachable surface.
#
# Everything behind this is on an internal compose network with no route out.
# Caddy terminates TLS (automatic ACME when PUBLIC_HOST is a real name, internal
# CA otherwise) and enforces HTTP Basic on every path — there is no unauthenticated
# route, including health checks, because a health endpoint that names the
# snapshot hash and the trap state is itself information about the experiment.

{
	# No global `email` directive: with ACME_EMAIL unset it expands to a bare
	# `email` and Caddy refuses the whole config with "wrong argument count".
	# This deployment uses TLS_MODE=internal anyway, so ACME is not in play.
	admin off
	auto_https disable_redirects

	# Клиент, пришедший по IP, не посылает SNI — по спецификации TLS туда можно
	# положить только имя. Без SNI Caddy не может выбрать сертификат из
	# нескольких и рвёт рукопожатие с internal error: браузер на
	# https://<адрес> получает не предупреждение о самоподписанном
	# сертификате, а вообще ничего. Этот адрес и есть основной способ сюда
	# попасть, поэтому для соединений без SNI задаётся имя по умолчанию.
	default_sni {$DEFAULT_SNI}
}

{$PUBLIC_HOST} {
	# TLS mode is env-driven because this host has no DNS name: it is reachable
	# on a public IPv6 address and a NATed private IPv4. ACME cannot issue for a
	# bare IP, so TLS_MODE=internal makes Caddy mint its own certificate.
	# Browsers will warn — that is the honest cost of having no name. With a real
	# DNS name, set PUBLIC_HOST to it and TLS_MODE to your ACME email instead.
	tls {$TLS_MODE}

	encode zstd gzip

	# One credential guards the whole surface. Per-service accounts would be a
	# false sense of separation: research-api can already launch experiments and
	# admin-ui can already approve skills, so anyone with either has the system.
	basic_auth {
		researcher {$BASIC_AUTH_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# ---- research API (C4)
	handle_path /research/* {
		reverse_proxy research-api:8083
	}

	# ---- admin UI (C5). It performs its own Basic auth as well; the duplication
	# is deliberate, so a proxy misconfiguration does not expose the approve
	# button. But HTTP Basic carries exactly one Authorization header, so the
	# researcher's edge credential cannot also satisfy the admin UI. The proxy
	# therefore authenticates the human at the edge and presents its own,
	# different credential upstream.
	#
	# The second factor is still real: anyone reaching admin-ui directly — by
	# bypassing the proxy, or from inside the compose network — still needs
	# ADMIN_PASSWORD, which only the proxy holds.
	handle_path /admin/* {
		reverse_proxy admin-ui:8084 {
			header_up Authorization "Basic {$ADMIN_BASIC}"
		}
	}

	# ---- Phoenix UI (C3)
	handle_path /phoenix/* {
		reverse_proxy phoenix:6006
	}

	# ---- agent API (C2), for researchers driving runs directly
	handle_path /agent/* {
		reverse_proxy b2e-agent:8082
	}

	# The Heimdall emulator is deliberately NOT published. It is the data plane;
	# only the agent should reach it, and it is on the internal network only.

	handle {
		respond "b2e simulation environment. /research /admin /phoenix /agent" 200
	}
}
