# Copy to deploy/.env and fill in. deploy/.env is gitignored and must stay that way.
#
# Every credential below is read from the environment. None of them may be
# written into code, a compose file, or a commit. If a credential is ever pasted
# into a chat or an issue, treat it as burned and rotate it.

# ---- exposure -------------------------------------------------------------
# Hostname or public IP researchers will use. With a real DNS name Caddy gets a
# public certificate automatically; with a bare IP it issues an internal one and
# browsers will warn.
PUBLIC_HOST=your.host.example.com

# Bind address for the proxy. 0.0.0.0 publishes to the internet — which is the
# requirement here — but NOTHING is unauthenticated behind it.
BIND_ADDRESS=0.0.0.0

# Email for Let's Encrypt. Leave blank to use Caddy's internal CA.
ACME_EMAIL=

# ---- proxy auth -----------------------------------------------------------
# Generate with:  make hash-password
# (runs `caddy hash-password` in a throwaway container; the plaintext never
# reaches a file)
BASIC_AUTH_HASH=

# ---- admin UI -------------------------------------------------------------
# The admin UI holds the skill approval button. It refuses to start without these.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---- datastores -----------------------------------------------------------
POSTGRES_PASSWORD=

# ---- model access ---------------------------------------------------------
# Subscription OAuth token (preferred, cheaper for simulation) OR an API key.
# CLAUDE_CODE_OAUTH_TOKEN takes precedence when both are set.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# replay | record | live.  `make test` requires replay and spends nothing.
B2E_LLM_MODE=replay

# ---- telegram (optional; enable with `make up PROFILE=telegram`) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_EMPLOYEE=

# ---- experiment conditions ------------------------------------------------
# Defaults for a fresh stack; both are switchable at runtime from the admin UI.
TRAPS_ENABLED=true
LATENCY_PROFILE=realistic

# Corpus to serve. DATA_DIR_NOTRAPS is only needed to run traps_enabled=false;
# without it the emulator refuses to switch rather than mislabel the data.
DATA_DIR=../data-small
DATA_DIR_NOTRAPS=../data-small-notraps

# Employees granted the HR role. Empty means nobody: HR access is an
# experimental condition, not a convenience.
HR_EMPLOYEE_IDS=

PHOENIX_PROJECT=b2e-sim
HEIMDALL_TOKEN=sim-technical-account
