# Copy to deploy/.env and fill in. deploy/.env is gitignored and must stay that way.
#
# Every credential below is read from the environment. None of them may be
# written into code, a compose file, or a commit. If a credential is ever pasted
# into a chat or an issue, treat it as burned and rotate it.
#
# Laptop defaults below target https://localhost:8443 with Caddy's internal CA.
# Browsers will warn; that is expected. curl needs -k.

# ---- exposure -------------------------------------------------------------
PUBLIC_HOST=localhost
DEFAULT_SNI=localhost
PUBLIC_URL=https://localhost:8443
TLS_MODE=internal

# Campus LAN: set PUBLIC_HOST and PUBLIC_URL to this host's 10.32.x IP,
# BIND_ADDRESS=0.0.0.0, TLS_MODE=internal. Recreate proxy + phoenix + admin-ui.
# ACME cannot issue for a bare IP; browsers will warn. HTTP Basic still required.
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
HTTP_PORT=8080

# Email for Let's Encrypt. Leave blank; TLS_MODE=internal does not use ACME.
ACME_EMAIL=

# ---- proxy auth -----------------------------------------------------------
# Generate with:  make hash-password
# (runs `caddy hash-password` in a throwaway container; the plaintext never
# reaches a file). Compose interpolates `$WORD` in --env-file values, so every
# `$` in the bcrypt string MUST be doubled: `$2a$14$…` → `$$2a$$14$$…`.
BASIC_AUTH_HASH=$$2a$$14$$Pe46pDGCHUy4pN715QmuiOjrbOjb7HzAZzF2xOrQgLtQu5c5are8W

# Plaintext matching BASIC_AUTH_HASH. Used by `make demo` and curl on the host;
# compose does not read it. The edge user is always `researcher`.
RESEARCHER_PASSWORD=itmo-local-researcher

# ---- admin UI -------------------------------------------------------------
# The admin UI holds the skill approval button. It refuses to start without these.
ADMIN_USER=admin
ADMIN_PASSWORD=itmo-local-admin

# base64("ADMIN_USER:ADMIN_PASSWORD"). Generate with:
#   scripts/make_admin_basic.sh
# The proxy presents this to admin-ui because HTTP Basic carries one header and
# the researcher's edge credential cannot also satisfy the UI's own auth.
ADMIN_BASIC=YWRtaW46aXRtby1sb2NhbC1hZG1pbg==

# ---- datastores -----------------------------------------------------------
POSTGRES_PASSWORD=itmo-local-postgres

# ---- model access ---------------------------------------------------------
# LLM_PROVIDER=zai | anthropic
# zai + messages_api: free Open Platform GLM Flash via ZAI_OPENAI_BASE_URL.
# zai + claude_code: Coding Plan Anthropic gateway (billed quota).
# anthropic: CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY (Haiku).
LLM_PROVIDER=zai
B2E_HARNESS=messages_api
B2E_MODEL=glm-4.5-flash

# Z.ai Coding Plan (Claude Code path). Values are passed into the CLI env.
ZAI_API_KEY=10c291c3d8b14cf5bc06a03c46b206ba.uATWhOEDRiHE3VgT
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-4.5-flash
ANTHROPIC_DEFAULT_SONNET_MODEL=glm-4.5-flash
ANTHROPIC_DEFAULT_OPUS_MODEL=glm-4.5-flash
CLAUDE_CODE_AUTO_COMPACT_WINDOW=200000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
API_TIMEOUT_MS=3000000

# Open Platform chat/completions. glm-4.5-flash / glm-4.7-flash are free here.
# Coding Plan's Anthropic gateway is a separate quota (the 429 recharge error).
ZAI_OPENAI_BASE_URL=https://api.z.ai/api/paas/v4

# Anthropic / Claude Code subscription path (LLM_PROVIDER=anthropic).
# CLAUDE_CODE_OAUTH_TOKEN takes precedence over ANTHROPIC_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# replay | record | live.  `make test` requires replay and spends nothing.
# `make demo` needs `live` and a working ZAI_API_KEY / ANTHROPIC_AUTH_TOKEN
# (or Anthropic credentials when LLM_PROVIDER=anthropic).
B2E_LLM_MODE=live

# Direct egress for Anthropic/Claude Code / Z.AI. Empty = direct.
# The original VPS reached Anthropic through a host proxy on 127.0.0.1:10809;
# set this (and start the `relay` profile) only if you actually have that proxy.
AGENT_HTTP_PROXY=

# ---- telegram (optional; enable with `make up PROFILE=telegram`) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_EMPLOYEE=
# Which shipped agent config a chat opens its session against.
# agent_config_interactive keeps one Claude Code session per chat.
# agent_config_messages_api is the messages_api golden-path config.
B2E_TELEGRAM_CONFIG_REF=agent_config_interactive

# ---- experiment conditions ------------------------------------------------
# Defaults for a fresh stack; both are switchable at runtime from the admin UI.
TRAPS_ENABLED=true
LATENCY_PROFILE=realistic

# Corpus to serve. DATA_DIR_NOTRAPS is only needed to run traps_enabled=false;
# without it the emulator refuses to switch rather than mislabel the data.
DATA_DIR=../data-previous
DATA_DIR_NOTRAPS=../data-small-notraps

# Employees granted the HR role. Empty means nobody: HR access is an
# experimental condition, not a convenience.
#
# `hr` is the only role that sees the whole company. A head is scoped to their
# own unit and everything beneath it — but in the generated corpus every
# populated unit is a leaf of ~21 people, so in practice a manager sees 21 and
# no more. Company-wide questions therefore need an id listed here.
#
# Changing it requires recreating heimdall-emulator: IdentityIndex is built at
# startup.
HR_EMPLOYEE_IDS=

PHOENIX_PROJECT=b2e-itmo
HEIMDALL_TOKEN=sim-technical-account
