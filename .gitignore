.venv/
__pycache__/
*.pyc
.pytest_cache/
# Шаблон, а не перечисление. Перечисление уже подвело: фикстура с новым именем
# .pytest-e2ereview/ утащила в индекс 1529 файлов корпуса вместе с truth/, потому
# что её имени не было в списке. Каталог корпуса не кладётся в репозиторий по
# правилу ниже, и имя фикстуры не должно быть тем, что это правило обходит.
.pytest-*/
# Разовые корпуса, которые собирают вручную при разборе: та же природа, только
# имя выбирает человек, а не фикстура.
.analysis-*/

# Корпус данных в репозиторий не кладётся: он детерминирован по seed и
# пересобирается командой `make data`. Гнать в git гигабайт, который
# восстанавливается за минуты, незачем.
data/
data-small/
*.log

# Спецификация OpenAPI лежит в репозитории: она нужна исследователю, чтобы
# пересобрать каталог витрин и понять форму боевого интерфейса. Это стало
# возможно только после перевода репозитория в private — пока он был публичным,
# спецификация внутреннего сервиса была исключена намеренно. Если репозиторий
# когда-нибудь снова сделают публичным, этот файл надо убрать первым.

# --- simulation environment -------------------------------------------------
# Secrets. Never commit. If one is ever pasted into a chat, rotate it.
deploy/.env
deploy/.env.bak-*
.env
*.env.bak

# Runtime state: registries, session stores, spool. Reproducible, not source.
var/
*.db
*.db-wal
*.db-shm

# Recorded LLM responses for replay mode. Regenerated with B2E_LLM_MODE=record;
# they can carry full prompts and HR payloads, so they stay out of git.
cassettes/

# Traps-off corpus, same policy as the traps-on one: rebuilt from seed.
data-small-notraps/
