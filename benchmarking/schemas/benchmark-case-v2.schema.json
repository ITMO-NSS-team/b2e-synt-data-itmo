{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b2e-itmo.local/benchmark-case-v2.schema.json",
  "title": "BenchmarkCase authorial contract v2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "status",
    "category",
    "query",
    "gold_contract",
    "source_type",
    "source_business_process",
    "employee_id",
    "employee_role",
    "snapshot_id",
    "skill_registry_hash",
    "expected_skills",
    "gold_answer",
    "gold_comparison"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "status": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "category": {
      "enum": [
        "answerable",
        "access_control",
        "no_data",
        "missing_skill",
        "out_of_scope"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "gold_contract": {
      "type": "object",
      "minProperties": 1,
      "description": "JSON Schema of normalized agent answer"
    },
    "source_type": {
      "type": "string",
      "minLength": 1
    },
    "source_business_process": {
      "type": "string",
      "minLength": 1
    },
    "employee_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "employee_role": {
      "enum": [
        "self",
        "manager",
        "hr"
      ]
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_registry_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Supplied case provenance, not the hash of each benchmark mode catalog"
    },
    "expected_skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gold_answer": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "rows"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "answer",
                "no_data",
                "missing_skill",
                "access_control",
                "out_of_scope"
              ]
            },
            "rows": {
              "type": "array"
            }
          }
        }
      ]
    },
    "gold_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordered",
        "row_key",
        "allow_extra_rows",
        "numeric_absolute_tolerance"
      ],
      "properties": {
        "ordered": {
          "type": "boolean"
        },
        "row_key": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allow_extra_rows": {
          "type": "boolean"
        },
        "numeric_absolute_tolerance": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "employee_id": {
            "type": "string",
            "minLength": 1
          },
          "gold_answer": {
            "type": "object"
          }
        }
      }
    }
  ]
}
