# Copy to sim/benchmark/.env. Keep local paths out of Git.
# This file takes precedence over inherited shell variables for benchmark runs.
# Only experiment settings belong here; stand services use deploy/.env.
# All relative host paths are resolved from the repository root.
CASES=b2e-skill-benchmark/gold_dataset
BENCHMARK_REPO_DIR=../b2e-skill-benchmark
# Legacy single-catalog setting; prefer BENCH_SKILL_CATALOGS for new runs.
GENERATED_SKILLS_DIR=
# Named catalogs of ready skills. Relative paths start at the stand root.
# Example: baseline=../skill-factory/baseline/runs/my-run,skillfactory=var/sf-output
BENCH_SKILL_CATALOGS=

BENCH_MODES=general_knowledge,skills_disabled,existing_skills
BENCH_REPETITIONS=1
BENCH_RESULTS=benchmarking/results
BENCH_TIMEOUT=1800
BENCH_TRACE_TIMEOUT=300
BENCH_HEALTH_TIMEOUT=60
BENCH_WORKERS=1
# Leave unset for a new eval_id on every run.
# BENCH_EVAL_ID=
# BENCH_LIMIT=
# BENCH_MAX_UNSCORED=
# Set both BENCH_EVAL_ID (the original run ID) and BENCH_RESUME=1 to resume.
# BENCH_RESUME=1
