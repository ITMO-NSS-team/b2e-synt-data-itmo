# Copy to sim/benchmark/.env. Keep credentials and local paths out of Git.
# This file configures the benchmark client, not the deployed services.
# All relative host paths are resolved from the repository root.
CASES=b2e-skill-benchmark/gold_dataset
BENCHMARK_REPO_DIR=b2e-skill-benchmark
# Legacy single-catalog setting; prefer BENCH_SKILL_CATALOGS for new runs.
GENERATED_SKILLS_DIR=
# Named catalogs of ready skills. Use absolute paths or paths relative to the stand root.
# Example: baseline=/path/to/baseline/run,skillfactory=/path/to/sf/output
BENCH_SKILL_CATALOGS=

BENCH_MODES=general_knowledge,skills_disabled,existing_skills
BENCH_REPETITIONS=1
BENCH_RESULTS=benchmarking/results
BENCH_TIMEOUT=1800
BENCH_TRACE_TIMEOUT=300
BENCH_HEALTH_TIMEOUT=60
BENCH_WORKERS=1
# Leave unset for a new eval_id on every run.
# BENCH_EVAL_ID=
# BENCH_MODEL=
# BENCH_LIMIT=

# Client connection to an existing stand. Match its public URL and credentials.
PUBLIC_URL=https://localhost:8443
PUBLIC_HOST=localhost
RESEARCHER_PASSWORD=
PHOENIX_PROJECT=b2e-itmo
BENCH_PHOENIX_PROJECT_ID=

# Optional host-side OpenLIT dashboard provisioning.
OPENLIT_CLICKHOUSE_URL=
OPENLIT_UI_URL=http://localhost:3000
OPENLIT_DB_USER=default
OPENLIT_DB_PASSWORD=
OPENLIT_DB_NAME=openlit

# Only for direct live_config/pin execution inside the stand's network.
# Make obtains these from the corresponding service's process environment.
B2E_REGISTRY_DB=/app/registry/registry.db
HEIMDALL_URL=http://heimdall-emulator:8081
HEIMDALL_SKILLS=/app/heimdall-skills
HEIMDALL_CATALOG=/app/catalog/snapshot.json
